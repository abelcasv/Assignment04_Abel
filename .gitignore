# ==============================================================================
# Assignment 4 — Git Ignore Rules
# ==============================================================================

# External read-only baseline repositories
/external_repos/

# Private student prompts, internal agent instructions, and task sequences
/CLAUDE.md
PROMPTS.md
*prompt*.txt
*prompts*.txt

# Obsolete / superseded archival drafts
CLAUDE_UPDATED.md
SPEC_UPDATED.md

# Build artifacts, binaries, and object files
build/bin/
*.exe
*.o
*.obj
*.so
*.dylib
*.dll

# Benchmark dense input matrices (Option B: deterministically generated on-demand; see data/README.md)
/data/dense/

# Generated runtime scratch directories
build/a1_runtime/
build/a3_runtime/

# LaTeX auxiliary build outputs (PDF remains tracked)
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.synctex.gz

# Python virtual environments, bytecode, and caches
.venv/
env/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE, OS, and editor metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
